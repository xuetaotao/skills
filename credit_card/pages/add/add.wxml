<view class="container form">
  <view class="field">
    <text class="label">银行</text>
    <picker mode="selector" range="{{banks}}" value="{{bankIndex}}" bindchange="onBankChange">
      <view class="picker">{{banks[bankIndex]}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">卡片类型</text>
    <picker mode="selector" range="{{cardTypes}}" value="{{cardTypeIndex}}" bindchange="onCardTypeChange">
      <view class="picker">{{cardTypes[cardTypeIndex]}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">卡号后4位</text>
    <input class="input" placeholder="如 8821" maxlength="4"
           data-field="cardLast4" value="{{form.cardLast4}}" bindinput="onInput" />
  </view>

  <view class="field">
    <text class="label">额度(¥)</text>
    <input class="input" type="digit" placeholder="如 50000"
           data-field="creditLimit" value="{{form.creditLimit}}" bindinput="onInput" />
  </view>

  <view class="field">
    <text class="label">启卡日期</text>
    <picker mode="date" value="{{form.activationDate}}" bindchange="onDateChange">
      <view class="picker">{{form.activationDate || '请选择'}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">年费(¥)</text>
    <input class="input" type="digit" placeholder="如 800"
           data-field="annualFee" value="{{form.annualFee}}" bindinput="onInput" />
  </view>

  <view class="field">
    <text class="label">减免类型</text>
    <picker mode="selector" range="{{waiverTypes}}" range-key="label"
            value="{{waiverTypeIndex}}" bindchange="onWaiverTypeChange">
      <view class="picker">{{waiverTypeIndex >= 0 ? waiverTypes[waiverTypeIndex].label : '请选择'}}</view>
    </picker>
  </view>

  <block wx:if="{{waiverTypeIndex >= 0 && waiverTypes[waiverTypeIndex].value === 'count'}}">
    <view class="field">
      <text class="label">达标笔数(目标)</text>
      <input class="input" type="number" placeholder="如 12"
             data-field="waiverTarget" value="{{form.waiverTarget}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">已刷笔数(进度)</text>
      <input class="input" type="number" placeholder="如 5"
             data-field="waiverProgress" value="{{form.waiverProgress}}" bindinput="onInput" />
    </view>
  </block>

  <block wx:if="{{waiverTypeIndex >= 0 && waiverTypes[waiverTypeIndex].value === 'amount'}}">
    <view class="field">
      <text class="label">达标金额(目标 ¥)</text>
      <input class="input" type="digit" placeholder="如 20000"
             data-field="waiverTarget" value="{{form.waiverTarget}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">已刷金额(进度 ¥)</text>
      <input class="input" type="digit" placeholder="如 8000"
             data-field="waiverProgress" value="{{form.waiverProgress}}" bindinput="onInput" />
    </view>
  </block>

  <view class="field">
    <text class="label">账单日(几号)</text>
    <input class="input" type="number" placeholder="1-28"
           data-field="billingDay" value="{{form.billingDay}}" bindinput="onInput" />
  </view>

  <view class="field">
    <text class="label">还款日(几号)</text>
    <input class="input" type="number" placeholder="1-28"
           data-field="repaymentDay" value="{{form.repaymentDay}}" bindinput="onInput" />
  </view>

  <view class="field col">
    <text class="label">备注</text>
    <textarea class="textarea" placeholder="选填,如特殊减免规则说明"
              data-field="remarks" value="{{form.remarks}}" bindinput="onInput" />
  </view>

  <button class="btn-primary save-btn" bindtap="save">保存</button>
</view>
