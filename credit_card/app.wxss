/* app.wxss —— 全局样式 */
page {
  background: #f2f3f5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f1f1f;
  font-size: 28rpx;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #b8e6c8;
  color: #fff;
}

/* 文本辅助 */
.muted {
  color: #9aa0a6;
  font-size: 24rpx;
}
